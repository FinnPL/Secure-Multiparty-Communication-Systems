\newcommand{\@cs@blockbegin}[3]{
	\setlength{\leftmargini}{\labelsep+\widthof{8}}%
	\setstretch{1}%
	\setbeamercolor{item}{fg=#2}%
	\@cs@storearea[-1.3mm-1.5bp]%
	\def\cs@curboxtype{#1}%
	\par%
	\begingroup%
	\tcolorbox[#1,#3]%
	\setbeamertemplate{itemize/enumerate body begin}[inblock]%
}
\newcommand{\@cs@blockend}{
	\endtcolorbox%
	\endgroup%
	%\vskip\smallskipamount%
	\@cs@storearea%
	\setbeamertemplate{itemize/enumerate body begin}[normal]%
}
\newcommand\comsysblocksubtitle[2][]{%
	\xdef\cs@tcb@origafterskip{\dimexpr\cs@tcb@afterskip+1bp\relax}
	\xdef\cs@tcb@origrightskip{\dimexpr\cs@tcb@rightskip\relax}
	\xdef\cs@tcb@origleftskip{\dimexpr\cs@tcb@leftskip\relax}
	\xdef\cs@tcb@origwidth{\dimexpr\cs@tcb@width\relax}
	\endtcolorbox%
	\endgroup%
	\begingroup%
	\pgfkeys{/cs@tmp/.cd,
		left skip/.store in=\cs@tcb@myleftskip,
		right skip/.store in=\cs@tcb@myrightskip,
		.unknown/.code={},
		left skip=\dimexpr(\cs@tcb@origwidth - #2\cs@tcb@origwidth) / 2\relax,
		right skip=\dimexpr(\cs@tcb@origwidth - #2\cs@tcb@origwidth) / 2\relax,
		#1}
	\tcolorbox[\cs@curboxtype,
	comsys/subtitle,
	colback=\cs@tcb@colframe,
	coltext={\pgfkeysvalueof{/tcb/comsys/colsub}},
	before skip=-\cs@tcb@origafterskip,
	width=\cs@tcb@origwidth,
	#1,
	left skip={\dimexpr \cs@tcb@origleftskip + \cs@tcb@myleftskip\relax},
	right skip={\dimexpr \cs@tcb@origrightskip + \cs@tcb@myrightskip\relax},
	]%
}

\newcommand\cs@deffullenv[4]{
	\newenvironment{comsys#1block}[1][]{%
			\@cs@blockbegin{comsys/#1box}{#2}{##1}%
			#3}
		{\par%
			\@cs@blockend%
			#4%
		}
}
\newcommand\cs@defbasicenv[2]{\cs@deffullenv{#1}{#2}{}{}}
\newcommand\cs@defcolenv[2]{\cs@deffullenv{#1}{#2}{%
	\setbeamertemplate{itemize/enumerate body begin}[inblock #1]%
	\setbeamertemplate{itemize/enumerate subbody begin}[inblock #1]%
	\setbeamertemplate{itemize/enumerate subsubbody begin}[inblock #1]%
}{
	\setbeamertemplate{itemize/enumerate subbody begin}[normal]%
	\setbeamertemplate{itemize/enumerate subsubbody begin}[normal]%
}}

\cs@defbasicenv{white}{RWTHblau}
\cs@defbasicenv{green}{RWTHgrun}
\cs@defbasicenv{yellow}{RWTHgelb}
\cs@defbasicenv{blue}{RWTHblau}
\cs@defcolenv{red}{RWTHrot}
\cs@defcolenv{gray}{gray!50}
\cs@defcolenv{inverted}{white}

