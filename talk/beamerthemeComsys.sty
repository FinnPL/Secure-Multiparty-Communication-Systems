		beforeafter skip=\smallskipamount,
	},
	boxrule/.prefix code={\def\cs@tcb@leftrule{#1}\def\cs@tcb@rightrule{#1}\def\cs@tcb@bottomrule{#1}\def\cs@tcb@toprule{#1}},
	comsys/.cd,
	bottom cutout dx/.initial=5mm,
	bottom cutout dy/.initial=1.5mm,
	bottom cutout/.default=0.3,
	bottom cutout/.style={after skip=\pgfkeysvalueof{/tcb/comsys/bottom cutout dy},/tcb/finish={
		\coordinate (inner south east) at ([xshift=-\cs@tcb@rightrule,yshift=\cs@tcb@bottomrule]frame.south east);
		\coordinate (inner south west) at ([xshift=\cs@tcb@leftrule,yshift=\cs@tcb@bottomrule]frame.south west);
		\pgfkeysgetvalue{/tcb/comsys/bottom cutout dx}{\cs@cutout@dx}
		\pgfkeysgetvalue{/tcb/comsys/bottom cutout dy}{\cs@cutout@dy}
		\path (inner south west) -- (inner south east) coordinate[pos=#1] (mid);
		\draw[tcbcolframe,tcb fill interior,line width=\cs@tcb@bottomrule] (mid) ++(-\cs@cutout@dx,0) coordinate (left) -- ++(0,-\dimexpr\cs@tcb@bottomrule/2) -- ++(\cs@tcb@bottomrule,0) -- ++(\cs@cutout@dx,-\cs@cutout@dy) -- ++(\cs@cutout@dx,\cs@cutout@dy) -- ++(\cs@tcb@bottomrule,0) -- ++(0,\dimexpr\cs@tcb@bottomrule/2) coordinate (right);
		% We draw these lines to prevent a sliver of the border color shining through
		% Unfortunately, we can't make them thin enough to be unnoticeable,
		% so we need to make sure to not "overdraw" the border (or fix it after the fact)
		\draw[line width=0pt,tcbcolback] (left) ++(\cs@tcb@bottomrule,0) -- (right);
		\draw[line width=0pt,tcbcolframe] (right) -- ++(-\cs@tcb@bottomrule,0);
	}},
	left icon/.style={
		leftrule=2em,
		comsys/auto right,
		underlay={
			\draw[tcbcolback,line width=\cs@tcb@arc] 
				([xshift=\dimexpr\cs@tcb@leftrule + (\cs@tcb@arc / 2),yshift=-\cs@tcb@toprule]frame.north west)
				-- ([xshift=\dimexpr\cs@tcb@leftrule + (\cs@tcb@arc / 2),yshift=\cs@tcb@bottomrule]frame.south west);
				\cs@drawicontext{#1};
		},
	},
	right icon/.style={
		rightrule=2em,
		comsys/auto left,
		underlay={
			\draw[tcbcolback,line width=\cs@tcb@arc] 
				([xshift=-\dimexpr\cs@tcb@rightrule + (\cs@tcb@arc / 2),yshift=-\cs@tcb@toprule]frame.north east)
				-- ([xshift=-\dimexpr\cs@tcb@rightrule + (\cs@tcb@arc / 2),yshift=\cs@tcb@bottomrule]frame.south east);
			\node[color=\pgfkeysvalueof{/tcb/comsys/icon color}] at ([xshift=-\dimexpr\cs@tcb@rightrule / 2]frame.east) {\pgfkeysvalueof{/tcb/comsys/icon font}#1};
		},
	},
	auto left/.style={left={\cs@tcb@rightrule+\cs@tcb@right-\cs@tcb@leftrule}},
	auto right/.style={right={\cs@tcb@leftrule+\cs@tcb@left-\cs@tcb@rightrule}},
	icon circle radius/.estore in=\cs@iconcircleradius,
	draw circled icon/.style n args={6}{
		#1={\dimexpr\cs@iconcircleradius + 1.3mm\relax},
