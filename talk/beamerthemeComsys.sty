\tcbuselibrary{hooks}
\tcbset{
	comsysboxbase/.style={
		enhanced,%
		halign=flush center,
		boxrule=1.5bp,%
		titlerule=-1pt,%
		left skip=0cm,%.125cm,%space left of the box
		right skip=0cm,%.125cm,%space right of the box
