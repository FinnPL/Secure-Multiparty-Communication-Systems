		fill=RWTHblau,
		inner sep=0,%
		outer sep=0,%
		draw=none,%
		fit={($(heading.north #2)+(#3,0)$) ($(heading.south #2)+(#3,0)$) (current page.#2|-heading.#2)},%
		#1,%
	] {};%
}

\newcommand{\heading}[2][]{%
	\par
	%\nointerlineskip%
	\ifcsname @cs@ncol\endcsname%
		\tikzset{@cs@hs/.style={minimum width=\textwidth}}%
	\else%
		\hskip-2.3mm%
		\tikzset{@cs@hs/.style={}}%
	\fi%
	\tikz[remember picture]\node[%
		@cs@hs,
		fill=RWTHblau,
		font=\color{white}\bfseries,%
		rounded corners=2.3mm,%
		inner sep=2.3mm,%
		outer sep=0,%
		draw=none,%
		#1,%
	] (heading) {%
	%\usebeamerfont{frametitle}%
		\par\smash{#2}\vphantom{T}\par%
	};%
	\ifcsname @cs@ncol\endcsname%
		\ifnum\thecol=1%
			\@cs@headingex[#1]{west}{2.3mm}%
		\else%
			\ifnum\thecol=\@cs@ncol%
				\@cs@headingex[#1]{east}{-2.3mm}%
			\fi%
		\fi%
	\else%
		\@cs@headingex{west}{2.3mm}%
		\tikz[overlay,remember picture]\node[
			fill=RWTHblau,
			inner sep=0,%
			outer sep=0,%
			draw=none,%
			fit={($(heading.north east)-(2.3mm,0)$) ($(heading.south east)+(2.3mm,0)$)},%
			#1,%
		] {};%
		\tikz[overlay,remember picture]\node[
			fill=RWTHblau,
			rounded corners=2.3mm,%
			inner sep=0,%
			outer sep=0,%
			draw=none,%
			fit={(heading.north east) ($(heading.south west)+({min(\textwidth+2.3mm, 0.85\pagewidth-1.7*0.25cm)},0)$)},%
			#1,%
		] {};%
	\fi%
	\par%
	\ignorespacesafterend%
}

