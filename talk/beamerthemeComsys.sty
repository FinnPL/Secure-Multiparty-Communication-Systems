\defbeamertemplate*{footline}{comsys}
{%
	\hskip\Gm@lmargin%
	\begin{minipage}[c][10mm][t]{\dimexpr\pagewidth-\Gm@lmargin-\Gm@rmargin}%
		\rule{\dimexpr\pagewidth-\Gm@lmargin-\Gm@rmargin}{0.3pt}%
		\vskip2mm%
		\mbox{\begin{beamercolorbox}[wd=0.5\textwidth,ht=5mm]{short author}%
		\if@cs@numberinfooter%
		\usebeamerfont{framenumber}%
		\raisebox{\dimexpr 2.5mm - 0.5ex}{\insertframenumber}%
		\fi%
		\usebeamerfont{short author}%
		\hskip 0pt plus 5fill%
		\raisebox{\dimexpr 2.5mm - 0.5ex}{\insertshortauthor}%
			\hfill \hskip0pt%
		\end{beamercolorbox}}
\hfill
			\begin{tikzpicture}[baseline=(logo.south)] \node[inner sep=0,anchor=south east] (logo) {\includegraphics[height=5mm]{\insertnormallogo}}; \end{tikzpicture}
	\end{minipage}
}

\defbeamertemplate{footline}{title}
{%
